# ======================================================================
# DigiWear Git Ignore Rules
# ======================================================================

# Built Binaries & Gradle Build Outputs
*.iml
.gradle/
.kotlin/
/build/
*/build/
build/
captures/
.externalNativeBuild/
.cxx/
*.aab
*.dex
*.class
*.dm
*.apk
!release_bin/DigiWear-WearOS-release.apk
!release_bin/DigiWear-Companion-release.apk
!release_bin/digiwear-aosp-standard-watch-release.apk

# Sensitive Signing Keys & Release Keystores
signing/
*.jks
*.keystore
*.p12
*.key
*.pem
*.pk8
*.p8
*.der

# Local Environment, Credentials & Secrets
/local.properties
local.properties
*.properties.local
*.env
*.env.*
.env
google-services.json
secrets.properties
keystore.properties
release-secrets*
*.credentials

# Sensitive Release Documents, Marketing & Reddit Launch Posts
docs/REDDIT_POST.md
docs/*REDDIT*
*REDDIT*
*reddit*
*.reddit.md
marketing/
social/
release_notes_draft*
RELEASE_DRAFT*.md

# Temporary Files, Logs & Scratches
*.log
scratch/
.agents/
*.dump
*.tmp
*.bak
*.swp
*~
*.hprof
*.pyc
__pycache__/

# IDE, OS & Emulator Metadata
/.idea/
.idea/
*.iws
*.ipr
*.avd
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
